# ==============================================================
# PlantCare AI - Cloud Database & Backend Configuration
# ==============================================================

# 1. OPTION A: MongoDB Atlas Cloud Database (Recommended & Instant Setup)
# Example: mongodb+srv://admin:mypassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=plantcare_ai

# 2. OPTION B: Google Firebase Firestore Cloud Database
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# 3. Local Persistent Database (Auto Fallback)
SQLITE_DB_PATH=plantcare.db

# AI Model Paths
MODEL_PATH=app/model/plant_model.h5
CLASS_LABELS_PATH=app/train/class_labels.json
ALLOWED_ORIGINS=http://localhost,http://10.0.2.2
PLANTNET_API_KEY=
